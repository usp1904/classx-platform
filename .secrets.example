# Local-only secrets. Copy to .secrets (gitignored) and fill in real values.
# On Render/VPS use the platform's environment variables instead of files.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# SESSION_SECRET=generate-a-32-plus-character-random-string
# Registered playback origin for the IFrame player, e.g. https://classx.example
YOUTUBE_ORIGIN=https://yourdomain.com
# Education mode is opt-in and needs a YouTube Player for Education agreement.
YOUTUBE_EDU_ENABLED=false
# YOUTUBE_EDU_EMBED_BASE=https://youtubeeducation.com/embed
# YOUTUBE_EDU_SESSION_TOKEN=partner-issued-short-lived-token
