# ClassX Platform — Production .env (VPS)
# Copy to .env and replace placeholder values. NEVER commit this file.

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# CORS — set to your actual domain (no trailing slash)
CORS_ORIGIN=https://yourdomain.com

# Tutor provider — OpenRouter (required for AI tutor; without it, grounded-fallback is used)
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
OPENAI_BASE_URL=https://openrouter.ai/api/v1
TUTOR_MODEL=openai/gpt-4o-mini

# RAG providers (local = no external calls, works offline)
RAG_EMBEDDING_PROVIDER=local
RAG_RERANK_PROVIDER=none

# Node memory headroom for 4GB+ VPS (adjust to 4096 for 8GB RAM)
NODE_OPTIONS=--max-old-space-size=3072
